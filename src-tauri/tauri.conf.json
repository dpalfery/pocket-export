{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pocket Export",
  "version": "0.1.0",
  "identifier": "com.pocketexport.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../src/ui run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../src/ui run build",
    "frontendDist": "../src/ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pocket Export",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
